+/* HyPocket: the number of the last command buffer the GPU finished, in a page
+ * shared with our Mesa (HYPOCKET_FENCE_PATH), so the guest can check and wait
+ * for fences without a round trip that would queue behind its own commands.
+ * Must match virgl_vtest_winsys.c. */
+#define HYPOCKET_FENCE_MAGIC 0x43465048 /* "HPFC": the server keeps this page current */
+struct hypocket_fence_page {
+   int completed;
+   int waiters;
+   int magic;
+};
+static struct hypocket_fence_page *hypocket_fences;
+
+static void hypocket_fence_page_init(void)
+{
+   const char *path = getenv("HYPOCKET_FENCE_PATH");
+   if (!path)
+      return;
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   void *map = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   close(fd);
+   if (map != MAP_FAILED) {
+      hypocket_fences = map;
+      __atomic_store_n(&hypocket_fences->magic, HYPOCKET_FENCE_MAGIC, __ATOMIC_SEQ_CST);
+   }
+}
