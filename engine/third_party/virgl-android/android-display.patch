+/* HyPocket: with HYPOCKET_PROFILE set, where command processing time goes,
+ * logged every 600 command buffers. GL errors are checked once per command
+ * buffer instead of after every command (each check is a glGetError call
+ * into the driver); HYPOCKET_ERROR_CHECK_EACH brings back the check after
+ * every command, to find which one fails. */
+static struct {
+   int enabled, one_error_check;
+   unsigned submits;
+   double cmd_ms[VIRGL_MAX_COMMANDS], error_check_ms, switch_ms;
+   unsigned cmd_count[VIRGL_MAX_COMMANDS];
+} hypocket_profile = { .enabled = -1 };
+
+static double hypocket_profile_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static void hypocket_profile_log(void)
+{
+   double total = hypocket_profile.error_check_ms + hypocket_profile.switch_ms;
+   for (int i = 0; i < VIRGL_MAX_COMMANDS; i++)
+      total += hypocket_profile.cmd_ms[i];
+   fprintf(stderr, "hypocket-profile: %u command buffers, %.1f ms: context switches %.1f ms, error checks %.1f ms\n",
+           hypocket_profile.submits, total, hypocket_profile.switch_ms, hypocket_profile.error_check_ms);
+   /* The six commands that took longest. */
+   for (int n = 0; n < 6; n++) {
+      int best = -1;
+      for (int i = 0; i < VIRGL_MAX_COMMANDS; i++)
+         if (hypocket_profile.cmd_count[i] && (best < 0 || hypocket_profile.cmd_ms[i] > hypocket_profile.cmd_ms[best]))
+            best = i;
+      if (best < 0)
+         break;
+      fprintf(stderr, "hypocket-profile:   %-24s %7u calls %8.1f ms (%.2f us each)\n", vrend_get_comand_name(best),
+              hypocket_profile.cmd_count[best], hypocket_profile.cmd_ms[best],
+              1000.0 * hypocket_profile.cmd_ms[best] / hypocket_profile.cmd_count[best]);
+      hypocket_profile.cmd_count[best] = 0; /* left out of the next round */
+   }
+   static const char *const step_names[HYPOCKET_DRAW_STEPS] = {
+      "state", "select", "use program", "objects", "vertices", "misc", "draw call", "after",
+   };
+   fprintf(stderr, "hypocket-profile:   draw steps (ms):");
+   for (int i = 0; i < HYPOCKET_DRAW_STEPS; i++)
+      fprintf(stderr, " %s %.1f%s", step_names[i], hypocket_draw_ms[i], i + 1 < HYPOCKET_DRAW_STEPS ? "," : "\n");
+   memset(hypocket_draw_ms, 0, sizeof(hypocket_draw_ms));
+   memset(hypocket_profile.cmd_ms, 0, sizeof(hypocket_profile.cmd_ms));
+   memset(hypocket_profile.cmd_count, 0, sizeof(hypocket_profile.cmd_count));
+   hypocket_profile.error_check_ms = hypocket_profile.switch_ms = 0;
+   hypocket_profile.submits = 0;
+}
