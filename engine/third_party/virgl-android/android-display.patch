+/* HyPocket: draws skip GL calls that would set what is already set (each
+ * one costs CPU time in the phone's driver, and a changed binding can make
+ * the driver check its state again in the next glDraw). The caches below
+ * are per sub context (each has its own GL context) and are thrown away
+ * whenever anything else binds a vertex array object or deletes a buffer
+ * or vertex array object, which could leave a stale name bound.
+ * HYPOCKET_NO_DRAW_CACHE turns them off, to compare or to rule them out. */
+static unsigned hypocket_bind_epoch = 1;
+static int hypocket_draw_cache = -1;
+
+static inline void hypocket_bind_changed(void)
+{
+   hypocket_bind_epoch++;
+}
+
+static inline bool hypocket_cache_on(void)
+{
+   if (hypocket_draw_cache < 0)
+      hypocket_draw_cache = getenv("HYPOCKET_NO_DRAW_CACHE") == NULL;
+   return hypocket_draw_cache;
+}
