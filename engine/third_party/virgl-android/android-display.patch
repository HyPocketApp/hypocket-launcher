+/* HyPocket: backs a new 2D texture resource with an EGL image (an Android
+ * hardware buffer the phone's screen shows directly), so the guest draws
+ * straight into it. Only for resources nothing has used yet: the guest
+ * asks right after creating them. Returns the new texture name, or 0. */
+VIRGL_EXPORT GLuint hypocket_vrend_back_with_image(uint32_t res_id, void *image);
+VIRGL_EXPORT GLuint hypocket_vrend_back_with_image(uint32_t res_id, void *image)
+{
+   struct virgl_resource *res = virgl_resource_lookup(res_id);
+   if (!res || !res->pipe_resource || !image)
+      return 0;
+   struct vrend_resource *gr = (struct vrend_resource *)res->pipe_resource;
+   if (gr->target != GL_TEXTURE_2D || gr->base.last_level != 0 || gr->base.nr_samples > 1 ||
+       gr->base.array_size > 1 || !has_bit(gr->storage_bits, VREND_STORAGE_GL_TEXTURE) ||
+       has_bit(gr->storage_bits, VREND_STORAGE_EGL_IMAGE))
+      return 0;
+   GLuint old_id = gr->gl_id;
+   uint32_t old_bits = gr->storage_bits;
+   gr->storage_bits &= ~(VREND_STORAGE_GL_TEXTURE | VREND_STORAGE_GL_IMMUTABLE);
+   if (vrend_resource_alloc_texture(gr, gr->base.format, image) != 0) {
+      gr->gl_id = old_id;
+      gr->storage_bits = old_bits;
+      return 0;
+   }
+   glDeleteTextures(1, &old_id);
+   return gr->gl_id;
+}
