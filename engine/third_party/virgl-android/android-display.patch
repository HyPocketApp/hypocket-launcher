+static void hypocket_bind_vao(struct vrend_sub_context *sub_ctx, GLuint vao)
+{
+   if (hypocket_cache_on() && sub_ctx->hypocket_vao == vao && sub_ctx->hypocket_vao_epoch == hypocket_bind_epoch)
+      return;
+   glBindVertexArray(vao);
+   sub_ctx->hypocket_vao = vao;
+   sub_ctx->hypocket_vao_epoch = hypocket_bind_epoch;
+}
+
+static void hypocket_bind_ubo_range(struct vrend_sub_context *sub_ctx, GLuint index, GLuint buffer,
+                                    GLintptr offset, GLsizeiptr size)
+{
+   if (hypocket_cache_on() && index < HYPOCKET_UBO_SLOTS) {
+      if (sub_ctx->hypocket_ubo_epoch != hypocket_bind_epoch) {
+         memset(sub_ctx->hypocket_ubo, 0, sizeof(sub_ctx->hypocket_ubo));
+         sub_ctx->hypocket_ubo_epoch = hypocket_bind_epoch;
+      }
+      __typeof__(sub_ctx->hypocket_ubo[0]) *slot = &sub_ctx->hypocket_ubo[index];
+      if (buffer && slot->buffer == buffer && slot->offset == offset && slot->size == size)
+         return;
+      slot->buffer = buffer;
+      slot->offset = offset;
+      slot->size = size;
+   }
+   glBindBufferRange(GL_UNIFORM_BUFFER, index, buffer, offset, size);
