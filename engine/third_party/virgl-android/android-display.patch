+/*
+ * HyPocket: precise fences. Upstream's VCMD_RESOURCE_BUSY_WAIT ignores which
+ * resource it is asked about and answers whether the GPU has finished
+ * everything submitted so far, so a client waiting for its previous frame
+ * also waits for the frame it just sent, and Mesa creates a resource (a round
+ * trip) for every fence. Each command buffer already gets an implicit fence
+ * numbered in submission order; our Mesa numbers them the same way and asks
+ * about one: busy until that command buffer is done, waiting up to
+ * timeout_us microseconds (0: just ask; ~0: forever).
+ */
+int vtest_hypocket_fence_wait(UNUSED uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t buf[VCMD_HYPOCKET_FENCE_WAIT_SIZE];
+   if (ctx->input->read(ctx->input, buf, sizeof(buf)) != sizeof(buf))
+      return -1;
+   int seq = (int)buf[0];
+   uint32_t timeout_us = buf[1];
+   struct timespec start;
+   clock_gettime(CLOCK_MONOTONIC, &start);
+   virgl_renderer_poll();
+   bool busy;
+   for (;;) {
+      busy = renderer.implicit_fence_completed - seq < 0;
+      if (!busy || timeout_us == 0)
+         break;
+      int wait_ms = 100;
+      if (timeout_us != ~0u) {
+         struct timespec now;
+         clock_gettime(CLOCK_MONOTONIC, &now);
+         int64_t elapsed_us = (now.tv_sec - start.tv_sec) * 1000000ll + (now.tv_nsec - start.tv_nsec) / 1000;
+         int64_t left_us = (int64_t)timeout_us - elapsed_us;
+         if (left_us <= 0)
+            break;
+         wait_ms = left_us < 100000 ? (int)((left_us + 999) / 1000) : 100;
+      }
+      int fd = virgl_renderer_get_poll_fd();
+      if (fd >= 0) {
+         struct pollfd pfd = { fd, POLLIN, 0 };
+         poll(&pfd, 1, wait_ms);
+      } else {
+         usleep(200);
+      }
+      virgl_renderer_poll();
+   }
+   uint32_t reply[VTEST_HDR_SIZE + 1] = {
+      [VTEST_CMD_LEN] = 1,
+      [VTEST_CMD_ID] = VCMD_HYPOCKET_FENCE_WAIT,
+      [VTEST_CMD_DATA_START] = busy ? 1 : 0,
+   };
+   return vtest_block_write(ctx->out_fd, reply, sizeof(reply)) < 0 ? -1 : 0;
+}
