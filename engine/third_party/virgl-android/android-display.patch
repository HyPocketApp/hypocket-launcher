+/* HyPocket: where the server's time goes, logged every 5 seconds: decoding
+ * and running the guest's GL commands (SUBMIT), showing frames (PRESENT,
+ * which includes waiting for the screen to give a buffer back) and the
+ * rest. The remainder of the time the server waits for the guest. */
+static struct {
+   double window_start, submit_ms, present_ms, other_ms, fence_ms;
+   unsigned submits, presents, others, fences;
+   double total_submit_ms, total_present_ms, total_ms;
+   unsigned total_presents;
+} hypocket_stats;
+
+static double hypocket_stats_now_ms(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static void hypocket_stats_add(uint32_t id, double ms)
+{
+   double now = hypocket_stats_now_ms();
+   if (hypocket_stats.window_start == 0)
+      hypocket_stats.window_start = now;
+   if (id == VCMD_SUBMIT_CMD || id == VCMD_SUBMIT_CMD2) {
+      hypocket_stats.submit_ms += ms;
+      hypocket_stats.submits++;
+   } else if (id == VCMD_HYPOCKET_PRESENT) {
+      hypocket_stats.present_ms += ms;
+      hypocket_stats.presents++;
+   } else if (id == VCMD_RESOURCE_BUSY_WAIT || id == VCMD_HYPOCKET_FENCE_WAIT) {
+      /* Mostly waiting for the GPU on the guest's behalf, not work. */
+      hypocket_stats.fence_ms += ms;
+      hypocket_stats.fences++;
+   } else {
+      hypocket_stats.other_ms += ms;
+      hypocket_stats.others++;
+   }
+   double window = now - hypocket_stats.window_start;
+   if (window < 5000)
+      return;
+   hypocket_stats.total_submit_ms += hypocket_stats.submit_ms;
+   hypocket_stats.total_present_ms += hypocket_stats.present_ms;
+   hypocket_stats.total_ms += window;
+   hypocket_stats.total_presents += hypocket_stats.presents;
+   unsigned frames = hypocket_stats.presents ? hypocket_stats.presents : 1;
+   fprintf(stderr,
+           "hypocket-stats: %.1f s, %u frames: commands %.1f ms/frame (%.0f%% busy, %u submits), "
+           "present %.1f ms/frame, fence checks %u (%.1f ms), other %.1f ms (%u)\n",
+           window / 1000.0, hypocket_stats.presents, hypocket_stats.submit_ms / frames,
+           100.0 * hypocket_stats.submit_ms / window, hypocket_stats.submits, hypocket_stats.present_ms / frames,
+           hypocket_stats.fences, hypocket_stats.fence_ms, hypocket_stats.other_ms, hypocket_stats.others);
+   hypocket_stats.window_start = now;
+   hypocket_stats.submit_ms = hypocket_stats.present_ms = hypocket_stats.other_ms = hypocket_stats.fence_ms = 0;
+   hypocket_stats.submits = hypocket_stats.presents = hypocket_stats.others = hypocket_stats.fences = 0;
+}
+
+/* The client left: a summary of the whole session. */
+static void hypocket_stats_finish(void)
+{
+   double total = hypocket_stats.total_ms;
+   if (total <= 0)
+      return;
+   unsigned frames = hypocket_stats.total_presents ? hypocket_stats.total_presents : 1;
+   fprintf(stderr, "hypocket-stats: total %.1f s, %u frames: commands %.1f ms/frame (%.0f%% busy), present %.1f ms/frame\n",
+           total / 1000.0, hypocket_stats.total_presents, hypocket_stats.total_submit_ms / frames,
+           100.0 * hypocket_stats.total_submit_ms / total, hypocket_stats.total_present_ms / frames);
+}
