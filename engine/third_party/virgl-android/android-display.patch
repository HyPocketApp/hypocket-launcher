+/* HyPocket: makes a client's GL context current (without waiting for the GPU)
+ * so the direct display can sync with its rendering. */
+VIRGL_EXPORT bool hypocket_renderer_switch_context(uint32_t ctx_id);
+VIRGL_EXPORT bool hypocket_renderer_switch_context(uint32_t ctx_id)
+{
+   struct virgl_context *ctx = virgl_context_lookup(ctx_id);
+   /* Only virgl (vrend) contexts, not venus ones. */
