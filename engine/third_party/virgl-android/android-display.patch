+/* HyPocket: the guest presented a frame with eglSwapBuffers (Mesa patch). */
+bool hypocket_renderer_switch_context(uint32_t ctx_id);
+
+int vtest_hypocket_present(UNUSED uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t buf[VCMD_HYPOCKET_PRESENT_SIZE];
+   if (ctx->input->read(ctx->input, buf, sizeof(buf)) != sizeof(buf))
+      return -1;
+   struct vtest_resource *res = util_hash_table_get(ctx->resource_table, intptr_to_pointer(buf[0]));
+   struct virgl_renderer_resource_info info;
+   static bool logged;
+   if (!logged) {
+      logged = true;
+      fprintf(stderr, "hypocket-display: first present command, resource %u\n", buf[0]);
+   }
+   if (!res) {
+      static unsigned missing;
+      if (missing++ < 3)
+         fprintf(stderr, "hypocket-display: present of unknown resource %u\n", buf[0]);
+      return 0;
+   }
+   if (!hypocket_display_enabled())
+      return 0;
+   /* Switching makes the guest's GL context current without waiting for the GPU. */
+   if (!hypocket_renderer_switch_context(ctx->ctx_id)) {
+      static unsigned failed;
+      if (failed++ < 3)
+         fprintf(stderr, "hypocket-display: cannot switch to context %u\n", ctx->ctx_id);
+      return 0;
+   }
+   if (virgl_renderer_resource_get_info((int)res->res_id, &info) == 0)
+      hypocket_display_present(res->res_id, info.width, info.height, true);
+   return 0;
+}
