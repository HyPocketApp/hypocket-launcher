@@ -1020,3 +1020,15 @@ const char *virgl_egl_error_string(EGLint error)
     default: return "Unknown error";
     }
 }
+
+/* HyPocket: lets the server's direct display share textures with the renderer. */
+VIRGL_EXPORT bool hypocket_egl_get(EGLDisplay *display, EGLConfig *config, EGLContext *context);
+VIRGL_EXPORT bool hypocket_egl_get(EGLDisplay *display, EGLConfig *config, EGLContext *context)
+{
+   if (!egl || !egl->egl_ctx)
+      return false;
+   *display = egl->egl_display;
+   *config = egl->egl_conf;
+   *context = egl->egl_ctx;
+   return true;
+}
