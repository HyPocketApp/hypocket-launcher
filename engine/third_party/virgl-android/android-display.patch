+   int magic;
+};
+static struct hypocket_fence_page *hypocket_fences;
+
+void hypocket_vrend_set_fence_hook(void (*hook)(uint32_t fence_id));
+
+/* Fence numbers only move forward, though the sync thread and the main
+ * thread both report them. */
+static void hypocket_fence_page_complete(uint32_t fence_id)
+{
+   int completed = __atomic_load_n(&hypocket_fences->completed, __ATOMIC_SEQ_CST);
+   do {
+      if ((int)(fence_id - (uint32_t)completed) <= 0)
+         return;
+   } while (!__atomic_compare_exchange_n(&hypocket_fences->completed, &completed, (int)fence_id, false,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST));
+   if (__atomic_load_n(&hypocket_fences->waiters, __ATOMIC_SEQ_CST))
+      syscall(SYS_futex, &hypocket_fences->completed, FUTEX_WAKE, INT_MAX, NULL, NULL, 0);
+}
+
+static void hypocket_fence_page_init(void)
+{
+   const char *path = getenv("HYPOCKET_FENCE_PATH");
+   if (!path)
+      return;
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   void *map = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   close(fd);
+   if (map != MAP_FAILED) {
+      hypocket_fences = map;
+      __atomic_store_n(&hypocket_fences->magic, HYPOCKET_FENCE_MAGIC, __ATOMIC_SEQ_CST);
+      if (!getenv("HYPOCKET_FENCES_ON_MAIN_THREAD"))
+         hypocket_vrend_set_fence_hook(hypocket_fence_page_complete);
+   }
+}
