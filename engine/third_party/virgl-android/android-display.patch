+/* HyPocket: where the server's time goes, logged every 5 seconds: decoding
+ * and running the guest's GL commands (SUBMIT), showing frames (PRESENT,
+ * which includes waiting for the screen to give a buffer back) and the
+ * rest. The remainder of the time the server waits for the guest. */
+static struct {
+   double window_start, submit_ms, present_ms, other_ms, fence_ms;
+   unsigned submits, presents, others, fences;
+   double total_submit_ms, total_present_ms, total_ms;
+   unsigned total_presents;
+} hypocket_stats;
+
+static double hypocket_stats_now_ms(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static void hypocket_memory_log(const char *when);
+
+static void hypocket_stats_add(uint32_t id, double ms)
+{
+   double now = hypocket_stats_now_ms();
+   if (hypocket_stats.window_start == 0)
+      hypocket_stats.window_start = now;
+   if (id == VCMD_SUBMIT_CMD || id == VCMD_SUBMIT_CMD2) {
+      hypocket_stats.submit_ms += ms;
+      hypocket_stats.submits++;
+   } else if (id == VCMD_HYPOCKET_PRESENT) {
+      hypocket_stats.present_ms += ms;
+      hypocket_stats.presents++;
+   } else if (id == VCMD_RESOURCE_BUSY_WAIT || id == VCMD_HYPOCKET_FENCE_WAIT) {
+      /* Mostly waiting for the GPU on the guest's behalf, not work. */
+      hypocket_stats.fence_ms += ms;
+      hypocket_stats.fences++;
+   } else {
+      hypocket_stats.other_ms += ms;
+      hypocket_stats.others++;
+   }
+   double window = now - hypocket_stats.window_start;
+   if (window < 5000)
+      return;
+   hypocket_stats.total_submit_ms += hypocket_stats.submit_ms;
+   hypocket_stats.total_present_ms += hypocket_stats.present_ms;
+   hypocket_stats.total_ms += window;
+   hypocket_stats.total_presents += hypocket_stats.presents;
+   static bool memory_logged;
+   if (!memory_logged && hypocket_stats.total_ms >= 20000) {
+      memory_logged = true;
+      hypocket_memory_log("after 20 s");
+   }
+   unsigned frames = hypocket_stats.presents ? hypocket_stats.presents : 1;
+   fprintf(stderr,
+           "hypocket-stats: %.1f s, %u frames: commands %.1f ms/frame (%.0f%% busy, %u submits), "
+           "present %.1f ms/frame, fence checks %u (%.1f ms), other %.1f ms (%u)\n",
+           window / 1000.0, hypocket_stats.presents, hypocket_stats.submit_ms / frames,
+           100.0 * hypocket_stats.submit_ms / window, hypocket_stats.submits, hypocket_stats.present_ms / frames,
+           hypocket_stats.fences, hypocket_stats.fence_ms, hypocket_stats.other_ms, hypocket_stats.others);
+   hypocket_stats.window_start = now;
+   hypocket_stats.submit_ms = hypocket_stats.present_ms = hypocket_stats.other_ms = hypocket_stats.fence_ms = 0;
+   hypocket_stats.submits = hypocket_stats.presents = hypocket_stats.others = hypocket_stats.fences = 0;
+}
+
+/* HyPocket: where the server's resident memory is, from /proc/self/smaps:
+ * the GPU driver's mappings, the guest's resources (memfds the game maps
+ * too, so they also count in its own memory), malloc, other anonymous memory
+ * and code. Resident sizes count shared pages in full; PSS splits them. */
+static void hypocket_memory_log(const char *when)
+{
+   enum { GPU, GUEST, MALLOC, ANON, CODE, OTHER, KINDS };
+   static const char *const names[KINDS] = { "GPU driver", "guest resources", "malloc", "other anonymous",
+                                             "code", "other" };
+   unsigned long rss[KINDS] = { 0 }, pss[KINDS] = { 0 }, mappings = 0;
+   FILE *f = fopen("/proc/self/smaps", "re");
+   if (!f)
+      return;
+   char line[512];
+   int kind = OTHER;
+   while (fgets(line, sizeof(line), f)) {
+      unsigned long kb;
+      if (sscanf(line, "Rss: %lu kB", &kb) == 1) {
+         rss[kind] += kb;
+      } else if (sscanf(line, "Pss: %lu kB", &kb) == 1) {
+         pss[kind] += kb;
+      } else if (strchr(line, '-') && strchr(line, '-') < strchr(line, ' ')) {
+         /* A mapping: "start-end perms offset dev inode [path]". */
+         mappings++;
+         char *path = line;
+         for (int field = 0; field < 5 && path; field++) {
+            path = strchr(path, ' ');
+            while (path && *path == ' ')
+               path++;
+         }
+         if (!path || *path == '\n' || *path == 0)
+            kind = ANON;
+         else if (strstr(path, "/dev/mali") || strstr(path, "/dev/kgsl") || strstr(path, "dmabuf") ||
+                  strstr(path, "/dev/dri") || strstr(path, "gralloc") || strstr(path, "/dev/ion"))
+            kind = GPU;
+         else if (strstr(path, "vtest-res"))
+            kind = GUEST;
+         else if (strstr(path, "scudo") || strstr(path, "malloc") || strstr(path, "jemalloc") ||
+                  strstr(path, "[heap]"))
+            kind = MALLOC;
+         else if (path[0] == '[')
+            kind = ANON;
+         else if (strstr(path, ".so") || strstr(path, "/system/"))
+            kind = CODE;
+         else
+            kind = OTHER;
+      }
+   }
+   fclose(f);
+   unsigned long hwm = 0;
+   f = fopen("/proc/self/status", "re");
+   if (f) {
+      while (fgets(line, sizeof(line), f))
+         if (sscanf(line, "VmHWM: %lu kB", &hwm) == 1)
+            break;
+      fclose(f);
+   }
+   fprintf(stderr, "hypocket-memory: %s, peak %lu MB, %lu mappings:", when, hwm / 1024, mappings);
+   for (int i = 0; i < KINDS; i++)
+      fprintf(stderr, " %s %.1f MB (pss %.1f)%s", names[i], rss[i] / 1024.0, pss[i] / 1024.0,
+              i + 1 < KINDS ? "," : "\n");
+}
+
+/* The client left: a summary of the whole session, the last (shorter)
+ * window included, so that sessions under 5 seconds have one too. */
+static void hypocket_stats_finish(void)
+{
+   if (hypocket_stats.window_start > 0) {
+      hypocket_stats.total_submit_ms += hypocket_stats.submit_ms;
+      hypocket_stats.total_present_ms += hypocket_stats.present_ms;
+      hypocket_stats.total_ms += hypocket_stats_now_ms() - hypocket_stats.window_start;
+      hypocket_stats.total_presents += hypocket_stats.presents;
+   }
+   hypocket_memory_log("at the end");
+   double total = hypocket_stats.total_ms;
+   if (total <= 0)
+      return;
+   unsigned frames = hypocket_stats.total_presents ? hypocket_stats.total_presents : 1;
+   fprintf(stderr, "hypocket-stats: total %.1f s, %u frames: commands %.1f ms/frame (%.0f%% busy), present %.1f ms/frame\n",
+           total / 1000.0, hypocket_stats.total_presents, hypocket_stats.total_submit_ms / frames,
+           100.0 * hypocket_stats.total_submit_ms / total, hypocket_stats.total_present_ms / frames);
+}
+
 static int vtest_client_dispatch_commands(struct vtest_client *client);
 
+/* HyPocket: memory the app and the game share (the audio ring), as memfds
+ * named in HYPOCKET_MEMFDS ("name:bytes,name:bytes"). A shared file in the
+ * app's storage is written back now and then, and writing to it meanwhile
+ * can stall for tens of milliseconds on a slow phone. Neither the app nor
+ * the game can hand the other an fd (Android starts them as separate
+ * processes and closes inherited fds), but both can open this process's
+ * /proc/<pid>/fd/<n>; each is printed before the socket exists, and stays
+ * open for as long as this process runs (mappings keep it alive after). */
+static void hypocket_memfds_create(void)
+{
+   const char *spec = getenv("HYPOCKET_MEMFDS");
+   while (spec && *spec) {
+      char name[32];
+      unsigned long size = 0;
+      int used = 0;
+      if (sscanf(spec, "%31[^:]:%lu%n", name, &size, &used) != 2 || size == 0 || size > (64u << 20))
+         break;
+      spec += used;
+      if (*spec == ',')
+         spec++;
+#ifdef __NR_memfd_create
+      int fd = syscall(__NR_memfd_create, name, 1u /* MFD_CLOEXEC */);
+#else
+      int fd = -1;
+#endif
+      if (fd < 0 || ftruncate(fd, (off_t)size) != 0) {
+         fprintf(stderr, "hypocket-memfd: %s failed\n", name);
+         if (fd >= 0)
+            close(fd);
+         continue;
+      }
+      fprintf(stderr, "hypocket-memfd: %s /proc/%d/fd/%d\n", name, (int)getpid(), fd);
+   }
+   fflush(stderr);
+}
+
 
