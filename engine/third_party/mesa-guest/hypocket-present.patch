+/*
+ * HyPocket: with HYPOCKET_PRESENT set, eglSwapBuffers on a pbuffer presents
+ * it: the virgl vtest winsys tells the VirGL server to show the pbuffer's
+ * image on the phone's screen. Pbuffers here render to a front image (see
+ * surfaceless_image_get_buffers). Without the variable it does nothing, as
+ * before.
+ *
+ * After the first present the pbuffer switches to HYPOCKET_IMAGES new images
+ * used in turn, and the server is told about each one before it is drawn
+ * into (HYPOCKET_ADOPT_DRAWABLE), so it can back it with a buffer the screen
+ * shows directly: the guest then draws straight into what the phone shows,
+ * while the screen still shows the previous images.
+ */
+static EGLBoolean
+surfaceless_swap_buffers(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("HYPOCKET_PRESENT") != NULL;
+
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+   _EGLContext *ctx = _eglGetCurrentContext();
+   if (!enabled || !ctx || !dri2_surf->front || !dri2_surf->front->texture)
+      return EGL_TRUE;
+
+   struct dri_context *dri_ctx = dri2_egl_context(ctx)->dri_context;
+   struct pipe_screen *screen = dri2_dpy->dri_screen_render_gpu->base.screen;
+   if (!screen->flush_frontbuffer)
+      return EGL_TRUE;
+   dri_flush_drawable(dri2_surf->dri_drawable);
+   screen->flush_frontbuffer(screen, dri_ctx->st->pipe, dri2_surf->front->texture, 0, 0,
+                             HYPOCKET_PRESENT_DRAWABLE, 0, NULL);
+
+   if (!dri2_surf->hypocket_images[0]) {
+      struct dri_image *images[HYPOCKET_IMAGES];
+      for (int i = 0; i < HYPOCKET_IMAGES; i++) {
+         images[i] = surfaceless_alloc_image(dri2_dpy, dri2_surf);
+         if (!images[i] || !images[i]->texture) {
+            /* Keep the single image. */
+            for (int j = 0; j <= i; j++)
+               if (images[j])
+                  dri2_destroy_image(images[j]);
+            return EGL_TRUE;
+         }
+      }
+      for (int i = 0; i < HYPOCKET_IMAGES; i++) {
+         screen->flush_frontbuffer(screen, dri_ctx->st->pipe, images[i]->texture, 0, 0,
+                                   HYPOCKET_ADOPT_DRAWABLE, 0, NULL);
+         dri2_surf->hypocket_images[i] = images[i];
+      }
+      /* The framebuffer keeps its own reference until it is validated again. */
+      dri2_destroy_image(dri2_surf->front);
+      dri2_surf->hypocket_current = -1;
+   }
+   dri2_surf->hypocket_current = (dri2_surf->hypocket_current + 1) % HYPOCKET_IMAGES;
+   dri2_surf->front = dri2_surf->hypocket_images[dri2_surf->hypocket_current];
+   dri_invalidate_drawable(dri2_surf->dri_drawable);
+   return EGL_TRUE;
+}
