+/* Through the shared page: no round trip, so no waiting behind our own
+ * commands still queued at the server. Sleeps on a futex the server wakes
+ * when it records a finished command buffer. */
+static bool hypocket_page_busy(struct hypocket_fence_page *page, uint32_t seq, uint32_t timeout_us)
+{
+   int done = __atomic_load_n(&page->completed, __ATOMIC_SEQ_CST);
+   if (done - (int)seq >= 0)
+      return false;
+   if (timeout_us == 0)
+      return true;
+   int64_t start = os_time_get_nano();
+   __atomic_fetch_add(&page->waiters, 1, __ATOMIC_SEQ_CST);
+   for (;;) {
+      done = __atomic_load_n(&page->completed, __ATOMIC_SEQ_CST);
+      if (done - (int)seq >= 0)
+         break;
+      int64_t wait_ns = 50000000; /* look again at least every 50 ms */
+      if (timeout_us != ~0u) {
+         int64_t left = (int64_t)timeout_us * 1000 - (os_time_get_nano() - start);
+         if (left <= 0)
+            break;
+         if (left < wait_ns)
+            wait_ns = left;
+      }
+      struct timespec ts = { wait_ns / 1000000000, wait_ns % 1000000000 };
+      syscall(SYS_futex, &page->completed, FUTEX_WAIT, done, &ts, NULL, 0);
+   }
+   __atomic_fetch_sub(&page->waiters, 1, __ATOMIC_SEQ_CST);
+   return done - (int)seq < 0;
+}
+
+bool virgl_vtest_hypocket_fence_busy(struct virgl_vtest_winsys *vws,
+                                     uint32_t seq, uint32_t timeout_us)
+{
+   if (vws->hypocket_page) {
+      /* A wait without a deadline that takes over a second is unusual:
+       * confirm with the server directly, which cannot go stale. */
+      bool busy = hypocket_page_busy(vws->hypocket_page, seq, timeout_us == ~0u ? 1000000 : timeout_us);
+      if (!busy || timeout_us != ~0u)
+         return busy;
+   }
+
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t cmd[2] = { seq, timeout_us };
+   uint32_t result[1] = { 0 };
+   vtest_hdr[VTEST_CMD_LEN] = 2;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_HYPOCKET_FENCE_WAIT;
+   virgl_block_write(vws->sock_fd, &vtest_hdr, sizeof(vtest_hdr));
+   virgl_block_write(vws->sock_fd, &cmd, sizeof(cmd));
+   if (virgl_block_read(vws->sock_fd, vtest_hdr, sizeof(vtest_hdr)) <= 0 ||
+       virgl_block_read(vws->sock_fd, result, sizeof(result)) <= 0)
+      return false;
+   return result[0] != 0;
+}
