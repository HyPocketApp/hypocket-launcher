+/* HyPocket: commands only HyPocket's VirGL server knows. */
+#define VCMD_HYPOCKET_PRESENT 64
+#define VCMD_HYPOCKET_ADOPT 65
+
+static int virgl_vtest_send_hypocket(struct virgl_vtest_winsys *vws,
+                                     uint32_t id, uint32_t handle)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t cmd[1] = { handle };
+   vtest_hdr[VTEST_CMD_LEN] = 1;
+   vtest_hdr[VTEST_CMD_ID] = id;
+   virgl_block_write(vws->sock_fd, &vtest_hdr, sizeof(vtest_hdr));
+   virgl_block_write(vws->sock_fd, &cmd, sizeof(cmd));
+   return 0;
+}
+
+int virgl_vtest_send_hypocket_present(struct virgl_vtest_winsys *vws,
+                                      uint32_t handle)
+{
+   return virgl_vtest_send_hypocket(vws, VCMD_HYPOCKET_PRESENT, handle);
+}
+
+int virgl_vtest_send_hypocket_adopt(struct virgl_vtest_winsys *vws,
+                                    uint32_t handle)
+{
+   return virgl_vtest_send_hypocket(vws, VCMD_HYPOCKET_ADOPT, handle);
+}
